# ===================================
# V-wallet- GITIGNORE
# ===================================

# ===============================
# ARCHIVOS DE ENTORNO Y SECRETOS
# ===============================
.env
.env.*
!.env.sample
!.env.example

# Variables de entorno por servicio
database-service/.env
api-gateway/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ===============================
# NODE.JS / NPM
# ===============================
node_modules/
*/node_modules/
**/node_modules/

# Logs de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Archivos de bloqueo (mantener solo uno)
package-lock.json
yarn.lock

# Cache de npm
.npm
.npmrc

# ===============================
# PRISMA / BASE DE DATOS
# ===============================
# Migraciones locales de desarrollo
database-service/prisma/migrations/
database-service/prisma/dev.db
database-service/prisma/dev.db-journal

# Cliente generado de Prisma
database-service/node_modules/.prisma/
database-service/prisma/generated/

# Backups de base de datos
*.sql
*.db
*.sqlite
*.sqlite3

# ===============================
# REACT / FRONTEND
# ===============================
# Build de producción
frontend/build/
frontend/dist/

# Cache y archivos temporales
frontend/.eslintcache
frontend/src/setupTests.js
frontend/public/static/

# Coverage de tests
frontend/coverage/

