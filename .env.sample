# Configuración de Base de Datos para el inicializador
# Estas variables son utilizadas por init-db.js para crear la BD y usuario de prueba

# Host del servidor MySQL (por defecto localhost en XAMPP)
DB_HOST=localhost

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Usuario de MySQL (por defecto 'root' en XAMPP)
DB_USER=root

# Contraseña de MySQL (vacía por defecto en XAMPP)
DB_PASSWORD=

# Nombre de la base de datos a crear
DB_NAME=wallet_db

# URL completa de conexión para Prisma (opcional - se construye automáticamente)
# Solo especifica esta variable si necesitas sobrescribir la construcción automática
# DATABASE_URL=mysql://root@localhost:3306/wallet_db